// Karkain-API - endpoint contracts and API development primitives.
// Karkain Language v1.2.0 verified baseline (tag v1.2.0,
// commit 77d70693e1e3134dac312a303bffafa7d50fa988).
//
// Scope boundary: this framework describes endpoint contracts and
// validates them before a host binds them to a transport. It does not
// implement an HTTP server or duplicate Karkain-Web's router.
//
// Representation: an API is a flat array of quadruples
//   [name, method, path, status_code, ...]
// Arrays are values; mutating functions return the updated API.

// new_api returns an empty contract.
public func new_api() {
    return []
}

// add_endpoint registers or replaces a named endpoint contract.
public func add_endpoint(api, name, method, path, status_code) {
    let out = remove_endpoint(api, name)
    out = push(out, name)
    out = push(out, method)
    out = push(out, path)
    out = push(out, status_code)
    return out
}

// remove_endpoint deletes a named endpoint.
public func remove_endpoint(api, name) {
    let out = []
    let i = 0
    while (i < len(api)) {
        if api[i] == name {
            i = i + 4
        } else {
            out = push(out, api[i])
            out = push(out, api[i + 1])
            out = push(out, api[i + 2])
            out = push(out, api[i + 3])
            i = i + 4
        }
    }
    return out
}

// endpoint_count returns the number of declared endpoints.
public func endpoint_count(api) {
    return len(api) / 4
}

// has_endpoint reports whether a named endpoint exists.
public func has_endpoint(api, name) {
    let i = 0
    while (i < len(api)) {
        if api[i] == name {
            return true
        }
        i = i + 4
    }
    return false
}

// endpoint_method returns the HTTP method of a named endpoint.
public func endpoint_method(api, name) {
    let i = 0
    while (i < len(api)) {
        if api[i] == name {
            return api[i + 1]
        }
        i = i + 4
    }
    return ""
}

// endpoint_path returns the path of a named endpoint.
public func endpoint_path(api, name) {
    let i = 0
    while (i < len(api)) {
        if api[i] == name {
            return api[i + 2]
        }
        i = i + 4
    }
    return ""
}

// endpoint_status returns the declared success status code.
public func endpoint_status(api, name) {
    let i = 0
    while (i < len(api)) {
        if api[i] == name {
            return api[i + 3]
        }
        i = i + 4
    }
    return 0
}

// status_text maps common status codes to stable labels.
public func status_text(code) {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 500 { return "Internal Server Error" }
    return "Unknown"
}

// validate_contract counts endpoints with an empty path or an empty
// method. A valid contract returns 0 problems.
public func validate_contract(api) {
    let problems = 0
    let i = 0
    while (i < len(api)) {
        if api[i + 1] == "" {
            problems = problems + 1
        } else {
            if api[i + 2] == "" {
                problems = problems + 1
            }
        }
        i = i + 4
    }
    return problems
}

// describe_endpoint builds a one-line endpoint diagnostic.
public func describe_endpoint(api, name) {
    if has_endpoint(api, name) == false {
        return name + " -> <missing>"
    }
    return name + " -> " + endpoint_method(api, name) + " " + endpoint_path(api, name) + " (" + str(endpoint_status(api, name)) + ")"
}

// ---------------------------------------------------------------------------
// Phase 2 additions. Phase 1 endpoint API is unchanged.

// api_version builds a stable version label.
public func api_version(major, minor) {
    return "v" + str(major) + "." + str(minor)
}

// version_compatible compares equal-format version labels.
public func version_compatible(current, required) {
    return current >= required
}

// new_bindings creates an empty parameter binding store.
public func new_bindings() {
    return []
}

// add_binding declares that an endpoint parameter comes from a source.
public func add_binding(bindings, endpoint, parameter, source) {
    let out = bindings
    out = push(out, endpoint)
    out = push(out, parameter)
    out = push(out, source)
    return out
}

// binding_count returns the number of declared bindings.
public func binding_count(bindings) {
    return len(bindings) / 3
}

// binding_source returns the source of an endpoint parameter or "".
public func binding_source(bindings, endpoint, parameter) {
    let i = 0
    while (i < len(bindings)) {
        if bindings[i] == endpoint {
            if bindings[i + 1] == parameter {
                return bindings[i + 2]
            }
        }
        i = i + 3
    }
    return ""
}

// pagination returns [offset, limit] for a page and size.
public func pagination(page, size) {
    let p = page
    let s = size
    if p < 1 { p = 1 }
    if s < 1 { s = 1 }
    let out = []
    out = push(out, (p - 1) * s)
    out = push(out, s)
    return out
}

// matches_filter reports whether a value contains a filter substring.
public func matches_filter(value, filter) {
    if len(filter) == 0 { return true }
    return contains(value, filter)
}

// api_error builds a standard API error triple.
public func api_error(code, message) {
    let e = []
    e = push(e, code)
    e = push(e, message)
    e = push(e, "error")
    return e
}

// error_code returns an API error code.
public func error_code(err) { return err[0] }

// error_message returns an API error message.
public func error_message(err) { return err[1] }

// new_auth_contract creates an empty authorization requirement store.
public func new_auth_contract() {
    return []
}

// require_auth marks an endpoint as requiring a role.
public func require_auth(contract, endpoint, role) {
    let out = contract
    out = push(out, endpoint)
    out = push(out, role)
    return out
}

// auth_role returns the required role or "".
public func auth_role(contract, endpoint) {
    let i = 0
    while (i < len(contract)) {
        if contract[i] == endpoint { return contract[i + 1] }
        i = i + 2
    }
    return ""
}

// rate_exceeded reports whether a count exceeds a configured limit.
public func rate_exceeded(limit, count) {
    if limit < 1 { return true }
    return count > limit
}

// contract_compatible reports whether two APIs share the same endpoint
// method/path pairs. Extra endpoints in b are ignored.
public func contract_compatible(a, b) {
    let i = 0
    while (i < len(a)) {
        if has_endpoint(b, a[i]) == false { return false }
        if endpoint_method(b, a[i]) != a[i + 1] { return false }
        if endpoint_path(b, a[i]) != a[i + 2] { return false }
        i = i + 4
    }
    return true
}

// api_summary builds a one-line API diagnostic.
public func api_summary(api, version) {
    return version + ":endpoints=" + str(endpoint_count(api))
}
