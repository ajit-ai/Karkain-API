// Native tests for Karkain-API.

func sample_api() {
    let a = add_endpoint(new_api(), "get_user", "GET", "/users/{id}", 200)
    return add_endpoint(a, "create_user", "POST", "/users", 201)
}

func test_new_api() {
    assert_eq(endpoint_count(new_api()), 0)
    assert(has_endpoint(new_api(), "x") == false)
}

func test_add_and_count() {
    let a = sample_api()
    assert_eq(endpoint_count(a), 2)
    assert(has_endpoint(a, "get_user"))
}

func test_endpoint_fields() {
    let a = sample_api()
    assert_eq(endpoint_method(a, "get_user"), "GET")
    assert_eq(endpoint_path(a, "get_user"), "/users/{id}")
    assert_eq(endpoint_status(a, "create_user"), 201)
}

func test_missing_endpoint_fields() {
    let a = new_api()
    assert_eq(endpoint_method(a, "x"), "")
    assert_eq(endpoint_path(a, "x"), "")
    assert_eq(endpoint_status(a, "x"), 0)
}

func test_add_replaces() {
    let a = add_endpoint(sample_api(), "get_user", "PUT", "/u", 204)
    assert_eq(endpoint_count(a), 2)
    assert_eq(endpoint_method(a, "get_user"), "PUT")
    assert_eq(endpoint_status(a, "get_user"), 204)
}

func test_remove_endpoint() {
    let a = remove_endpoint(sample_api(), "get_user")
    assert_eq(endpoint_count(a), 1)
    assert(has_endpoint(a, "get_user") == false)
    assert(has_endpoint(a, "create_user"))
}

func test_status_text() {
    assert_eq(status_text(200), "OK")
    assert_eq(status_text(201), "Created")
    assert_eq(status_text(404), "Not Found")
    assert_eq(status_text(999), "Unknown")
}

func test_validate_contract_ok() {
    assert_eq(validate_contract(sample_api()), 0)
}

func test_validate_contract_bad() {
    let a = add_endpoint(new_api(), "bad", "", "", 200)
    assert_eq(validate_contract(a), 1)
}

func test_describe_endpoint() {
    let a = sample_api()
    assert_eq(describe_endpoint(a, "get_user"), "get_user -> GET /users/{id} (200)")
    assert_eq(describe_endpoint(a, "none"), "none -> <missing>")
}

// --- Phase 2 regression ---

func test_phase1_regression() {
    let a = sample_api()
    assert_eq(endpoint_count(a), 2)
    assert_eq(endpoint_method(a, "get_user"), "GET")
    assert_eq(endpoint_path(a, "create_user"), "/users")
    assert_eq(validate_contract(a), 0)
}

// --- Phase 2 additions ---

func test_api_version() {
    assert_eq(api_version(1, 2), "v1.2")
    assert(version_compatible("v1.2", "v1.1"))
    assert(version_compatible("v1.0", "v1.1") == false)
}

func test_bindings() {
    let b = add_binding(add_binding(new_bindings(), "get_user", "id", "path"), "get_user", "token", "header")
    assert_eq(binding_count(b), 2)
    assert_eq(binding_source(b, "get_user", "id"), "path")
    assert_eq(binding_source(b, "get_user", "missing"), "")
}

func test_pagination() {
    let p = pagination(3, 10)
    assert_eq(p[0], 20)
    assert_eq(p[1], 10)
    let clamped = pagination(0, 0)
    assert_eq(clamped[0], 0)
    assert_eq(clamped[1], 1)
}

func test_filtering() {
    assert(matches_filter("hello world", "world"))
    assert(matches_filter("hello", ""))
    assert(matches_filter("hello", "xyz") == false)
}

func test_api_error() {
    let e = api_error(404, "not found")
    assert_eq(error_code(e), 404)
    assert_eq(error_message(e), "not found")
    assert_eq(e[2], "error")
}

func test_auth_contract() {
    let c = require_auth(require_auth(new_auth_contract(), "get_user", "reader"), "create_user", "admin")
    assert_eq(auth_role(c, "get_user"), "reader")
    assert_eq(auth_role(c, "create_user"), "admin")
    assert_eq(auth_role(c, "none"), "")
}

func test_rate_limit() {
    assert(rate_exceeded(10, 10) == false)
    assert(rate_exceeded(10, 11))
    assert(rate_exceeded(0, 0))
}

func test_contract_compatible() {
    let a = sample_api()
    assert(contract_compatible(a, a))
    let reduced = add_endpoint(new_api(), "get_user", "GET", "/users/{id}", 200)
    assert(contract_compatible(a, reduced) == false)
}

func test_api_summary() {
    assert_eq(api_summary(sample_api(), "v1.0"), "v1.0:endpoints=2")
}
